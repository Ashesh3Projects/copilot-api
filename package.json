{
  "name": "@ashsec/copilot-api",
  "version": "5.2.0",
  "description": "Self-hosted GitHub Copilot compatibility gateway for OpenAI, Anthropic, Google AI, Claude Code, and Codex clients.",
  "keywords": [
    "proxy",
    "github-copilot",
    "openai-compatible"
  ],
  "homepage": "https://github.com/Ashesh3/copilot-api#readme",
  "bugs": "https://github.com/Ashesh3/copilot-api/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Ashesh3/copilot-api.git"
  },
  "author": "Erick Christian <erickchristian48@gmail.com>",
  "type": "module",
  "bin": {
    "copilot-api": "./dist/main.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown",
    "build:ui": "cd ui && npm run build",
    "dev": "bun run --watch ./src/main.ts",
    "knip": "knip-bun",
    "lint": "eslint --cache",
    "lint:all": "eslint --cache .",
    "prepack": "bun run build",
    "prepare": "simple-git-hooks",
    "release": "bumpp && bun publish --access public",
    "start": "NODE_ENV=production bun run ./src/main.ts",
    "typecheck": "tsc"
  },
  "simple-git-hooks": {
    "pre-commit": "bunx lint-staged"
  },
  "lint-staged": {
    "*": "bun run lint --fix"
  },
  "dependencies": {
    "@sentry/bun": "^10.65.0",
    "@tursodatabase/serverless": "1.4.0",
    "citty": "^0.1.6",
    "clipboardy": "^5.0.0",
    "consola": "^3.4.2",
    "fetch-event-stream": "^0.1.5",
    "fflate": "^0.8.3",
    "gpt-tokenizer": "^3.0.1",
    "hono": "4.13.5",
    "ms": "^2.1.3",
    "proxy-from-env": "^1.1.0",
    "re2js": "^2.8.6",
    "tiny-invariant": "^1.3.3",
    "undici": "^7.29.0",
    "zod": "^4.1.11"
  },
  "devDependencies": {
    "@echristian/eslint-config": "^0.0.54",
    "@types/bun": "^1.4.0",
    "@types/proxy-from-env": "^1.0.4",
    "bumpp": "^10.2.3",
    "eslint": "^9.37.0",
    "knip": "^5.64.1",
    "lint-staged": "^16.2.3",
    "prettier-plugin-packagejson": "^2.5.19",
    "simple-git-hooks": "^2.13.1",
    "tsdown": "^0.15.6",
    "typescript": "^5.9.3"
  }
}
